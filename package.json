{
  "name": "aigc-studio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "cross-env NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
