# 复制为 .env.local 后填写。留空时可以管理项目、编辑关键词，AI 功能会提示未配置。
# 服务端配置，切勿使用 NEXT_PUBLIC_ 前缀。
ARK_API_KEY=
ARK_CHAT_MODEL=
ARK_VISION_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 即梦文生图 3.0，需要开通对应接口权限
VOLCENGINE_AK=
VOLCENGINE_SK=
VOLCENGINE_REGION=cn-north-1
VOLCENGINE_HOST=visual.volcengineapi.com

# 默认使用项目内 data 目录，可设置为 D:/AIGC-Studio-data
AIGC_DATA_DIR=

# 实验功能默认关闭：接口尚未经过真实账户验证
AIGC_ENABLE_EXPERIMENTAL=false
ARK_VIDEO_MODEL=
